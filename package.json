{
  "name": "fulgurspice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser circuit simulator: KiCad-style schematic capture, ngspice (WebAssembly) engine, LTspice-style waveform viewer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "eecircuit-engine": "1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": { "node": ">=20" }
}
